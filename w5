        <!-- Empty state placeholder -->
        <div id="emptyState" class="text-center py-12 bg-white/60 border-4 border-dashed border-amber-300 rounded-3xl">
          <i class="fa-solid fa-ghost text-5xl text-amber-300 mb-3"></i>
          <p class="font-bold text-amber-700">尚未有玩家送出心電感應...</p>
        </div>
