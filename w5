  </main>

  <!-- FOOTER -->
  <footer class="bg-amber-200 border-t-4 border-pokeDark py-4 px-4 text-center text-xs font-bold text-amber-900 mt-8">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <p>© 2026 Cloud Telepathy Party Game - Pokémon Styled Edition</p>
      <div class="flex items-center gap-4">
        <span><i class="fa-solid fa-signal text-emerald-600 mr-1"></i>Polling Mode (2s)</span>
        <span><i class="fa-solid fa-database text-blue-600 mr-1"></i>GAS Connected</span>
      </div>
    </div>
  </footer>

  <!-- JAVASCRIPT CORE LOGIC -->
  <script>
    // Constants required by spec
    const SHEET_NAME = 'TelepathyData';
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbyxFbozZ2bwyziyHMgWCU0xEDKEHE7j-tKADOdTsRN4cidh-bZgeD-W1n3tmdeez-Hb/exec";

    // Application State Variables
    let currentRoom = "";
    let playerName = "";
    let isHostVisible = false;
    let pollTimer = null;
    let currentAnswers = {};
    let currentStatus = "setup";
    let currentQuestion = "";
    let previousStatus = "";

    // Web Audio Sound FX Generator (No external audio assets needed!)
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    
    function playSound(type) {
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (type === 'click') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, audioCtx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.08);
      } else if (type === 'submit') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.25);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.25);
      } else if (type === 'reveal') {
        // Dramatic reveal chime
        const now = audioCtx.currentTime;
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
          const o = audioCtx.createOscillator();
          const g = audioCtx.createGain();
          o.type = 'sine';
          o.frequency.value = freq;
          o.connect(g);
          g.connect(audioCtx.destination);
          g.gain.setValueAtTime(0, now + idx * 0.08);
          g.gain.linearRampToValueAtTime(0.2, now + idx * 0.08 + 0.02);
          g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.5);
          o.start(now + idx * 0.08);
          o.stop(now + idx * 0.08 + 0.5);
        });
      }
    }

    // Helper: Toast Notifications
    function showToast(message, iconClass = "fa-solid fa-circle-info") {
      const toast = document.getElementById("toast");
      const msgEl = document.getElementById("toastMsg");
      const iconEl = document.getElementById("toastIcon");

      msgEl.innerText = message;
      iconEl.className = iconClass + " text-xl text-yellow-300";

      toast.classList.remove("translate-y-[-150%]", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");

      setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-[-150%]", "opacity-0");
      }, 3000);
    }

    // Auto-detect Room ID from URL Query Parameter
    window.addEventListener("DOMContentLoaded", () => {
      const urlParams = new URLSearchParams(window.location.search);
      const roomParam = urlParams.get("room");
      if (roomParam) {
        document.getElementById("inputRoomId").value = roomParam.trim().toUpperCase();
        showToast(`已載入房間號碼: ${roomParam}`, "fa-solid fa-link");
      }
    });

    // Generate Random Room ID
    function generateRandomRoom() {
      playSound('click');
      const randomCode = Math.floor(1000 + Math.random() * 9000).toString();
      document.getElementById("inputRoomId").value = randomCode;
      showToast(`已生成隨機房號: ${randomCode}`, "fa-solid fa-dice");
    }

    // Copy Share URL
    function copyShareUrl() {
      playSound('click');
      const url = new URL(window.location.href);
      url.searchParams.set("room", currentRoom);
      
      const textToCopy = url.toString();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          showToast("已複製房間邀請連結！", "fa-solid fa-copy");
        }).catch(() => fallbackCopy(textToCopy));
      } else {
        fallbackCopy(textToCopy);
      }
    }

    function fallbackCopy(text) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      showToast("已複製房間邀請連結！", "fa-solid fa-copy");
    }

    // Toggle Host Control Console
    function toggleHostConsole() {
      playSound('click');
      const panel = document.getElementById("hostConsolePanel");
      isHostVisible = !isHostVisible;
      if (isHostVisible) {
        panel.classList.remove("hidden");
        showToast("已開啟房主控制台", "fa-solid fa-unlock");
      } else {
        panel.classList.add("hidden");
        showToast("已隱藏房主控制台", "fa-solid fa-lock");
      }
    }

    // Handle Login / Joining Room
    function handleJoinGame(e) {
      e.preventDefault();
      playSound('click');

      const nameInput = document.getElementById("inputPlayerName").value.trim();
      const roomInput = document.getElementById("inputRoomId").value.trim().toUpperCase();

      if (!nameInput || !roomInput) {
        showToast("請填寫姓名與房號", "fa-solid fa-triangle-exclamation");
        return;
      }

      playerName = nameInput;
      currentRoom = roomInput;

      // Update UI Header
      document.getElementById("displayRoomId").innerText = currentRoom;
      document.getElementById("roomBadge").classList.remove("hidden");
      document.getElementById("roomBadge").classList.add("flex");
      document.getElementById("copyUrlBtn").classList.remove("hidden");
      document.getElementById("copyUrlBtn").classList.add("flex");

      // Switch Screens
      document.getElementById("loginScreen").classList.add("hidden");
      document.getElementById("gamePlayScreen").classList.remove("hidden");

      showToast(`訓練家 ${playerName} 進入房間 ${currentRoom}`, "fa-solid fa-right-to-bracket");

      // Fetch immediate data and start Polling
      fetchRoomData();
      startPolling();
    }

    // API POST Helper (Targeting GAS script)
    async function sendGasPost(actionData) {
      try {
        const payload = {
          room: currentRoom,
          playerName: playerName,
          ...actionData
        };

        const res = await fetch(GAS_API_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });
        
        return await res.json();
      } catch (err) {
        console.error("GAS POST Error:", err);
      }
    }

    // Host Actions
    async function hostSetQuestion() {
      playSound('click');
      const qInput = document.getElementById("hostQuestionInput").value.trim();
      if (!qInput) {
        showToast("請輸入題目內容！", "fa-solid fa-triangle-exclamation");
        return;
      }
      showToast("正在發布題目...", "fa-solid fa-spinner");
      await sendGasPost({ action: "set_question", question: qInput });
      document.getElementById("hostQuestionInput").value = "";
      fetchRoomData();
    }

    async function hostRevealCards() {
      playSound('click');
      showToast("開牌指令已發送！全員翻牌！", "fa-solid fa-wand-magic-sparkles");
      await sendGasPost({ action: "reveal" });
      fetchRoomData();
    }

    async function hostResetGame() {
      playSound('click');
      if (confirm("確定要重置題目與所有人答案嗎？")) {
        showToast("正在重置房間狀態...", "fa-solid fa-arrows-rotate");
        await sendGasPost({ action: "reset" });
        fetchRoomData();
      }
    }

    // Player Submit Answer
    async function handleAnswerSubmit(e) {
      e.preventDefault();
      playSound('submit');

      const ansInput = document.getElementById("playerAnswerInput").value.trim();
      if (!ansInput) return;

      showToast("答案送出中...", "fa-solid fa-paper-plane");
      await sendGasPost({ action: "submit_answer", answer: ansInput });

      document.getElementById("submittedNotice").classList.remove("hidden");
      showToast("答案提交成功！已鎖定心電感應。", "fa-solid fa-check-double");
      fetchRoomData();
    }

    // Polling Mechanism (Every 2000ms)
    function startPolling() {
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = setInterval(fetchRoomData, 2000);
    }

    // Fetch Room Data GET
    async function fetchRoomData() {
      if (!currentRoom) return;

      try {
        const response = await fetch(`${GAS_API_URL}?room=${encodeURIComponent(currentRoom)}`);
        const data = await response.json();

        // data format: { status: "setup"|"playing"|"revealed", question: "...", answers: { "PlayerA": "AnsA" } }
        const newStatus = data.status || "setup";
        const newQuestion = data.question || "";
        const newAnswers = data.answers || {};

        // Detect if status changed to 'revealed' to trigger reveal chime sound
        if (newStatus === "revealed" && previousStatus !== "revealed") {
          playSound('reveal');
        }
        previousStatus = newStatus;

        currentStatus = newStatus;
        currentQuestion = newQuestion;
        currentAnswers = newAnswers;

        updateUI();
      } catch (err) {
        console.error("Polling GET Error:", err);
      }
    }

    // Update UI based on fetched room state
    function updateUI() {
      // 1. Update Question text
      const qEl = document.getElementById("questionDisplay");
      if (currentStatus === "setup") {
        qEl.innerText = "等待房主出題中...";
      } else {
        qEl.innerText = currentQuestion || "等待房主設定題目...";
      }

      // 2. Update Status Badge
      const statusBadge = document.getElementById("gameStatusBadge");
      const statusText = document.getElementById("gameStatusText");

      if (currentStatus === "setup") {
        statusText.innerText = "準備階段 (Setup)";
        statusBadge.className = "mt-4 inline-flex items-center gap-2 text-sm font-bold px-4 py-1.5 rounded-xl border-2 border-pokeDark bg-white text-gray-700";
      } else if (currentStatus === "playing") {
        statusText.innerText = "玩家填答中 (Playing)";
        statusBadge.className = "mt-4 inline-flex items-center gap-2 text-sm font-bold px-4 py-1.5 rounded-xl border-2 border-pokeDark bg-amber-200 text-amber-900";
      } else if (currentStatus === "revealed") {
        statusText.innerText = "已開牌 (Revealed)";
        statusBadge.className = "mt-4 inline-flex items-center gap-2 text-sm font-bold px-4 py-1.5 rounded-xl border-2 border-pokeDark bg-emerald-300 text-emerald-950";
      }

      // 3. Update Player Answer Form Visibility
      const answerSection = document.getElementById("answerInputSection");
      const submittedNotice = document.getElementById("submittedNotice");

      if (currentStatus === "playing") {
        answerSection.classList.remove("hidden");
        // If player already answered
        if (currentAnswers[playerName]) {
          submittedNotice.classList.remove("hidden");
        } else {
          submittedNotice.classList.add("hidden");
        }
      } else {
        answerSection.classList.add("hidden");
      }

      // 4. Update Cards Grid
      renderCards();

      // 5. Match stats calculation if revealed
      renderMatchStats();
    }

    // Render 3D Cards
    function renderCards() {
      const grid = document.getElementById("cardsGrid");
      const emptyState = document.getElementById("emptyState");
      const countEl = document.getElementById("playerCount");

      const players = Object.keys(currentAnswers);
      countEl.innerText = players.length;

      if (players.length === 0) {
        grid.innerHTML = "";
        emptyState.classList.remove("hidden");
        return;
      }

      emptyState.classList.add("hidden");

      // Build cards HTML
      let html = "";
      players.forEach(pName => {
        const answer = currentAnswers[pName];
        const isSelf = (pName === playerName);
        const isFlipped = (currentStatus === "revealed");

        html += `
          <div class="card-scene">
            <div class="card-object ${isFlipped ? 'is-flipped' : ''}" id="card-${escapeHtml(pName)}">
              
              <!-- CARD BACK (Face Down - Pokeball Theme) -->
              <div class="card-face card-face-back flex flex-col justify-between p-4 overflow-hidden relative">
                <!-- Top Badge -->
                <div class="flex justify-between items-center z-10">
                  <span class="bg-pokeDark text-white text-xs px-2.5 py-1 rounded-full font-bold border border-yellow-400 truncate max-w-[120px]">
                    ${isSelf ? '<i class="fa-solid fa-star text-yellow-300 mr-1"></i>你' : '<i class="fa-solid fa-user mr-1"></i>' + escapeHtml(pName)}
                  </span>
                  <span class="bg-amber-100/90 text-pokeDark text-[10px] px-2 py-0.5 rounded-md font-black border border-pokeDark">
                    已鎖定
                  </span>
                </div>

                <!-- Center Pokeball Ornament -->
                <div class="pokeball-btn-center"></div>

                <!-- Bottom Status Indicator -->
                <div class="text-center z-10 mt-auto">
                  <div class="inline-block bg-white/90 border-2 border-pokeDark rounded-xl px-3 py-1 text-xs font-black text-pokeDark shadow">
                    <i class="fa-solid fa-circle-question text-pokeRed mr-1 animate-spin"></i> 心電思考中...
                  </div>
                </div>
              </div>

              <!-- CARD FRONT (Face Up - Revealed Answer Side) -->
              <div class="card-face card-face-front flex flex-col justify-between p-4 relative overflow-hidden">
                <!-- Top Header -->
                <div class="flex justify-between items-center border-b-2 border-amber-300 pb-2">
                  <span class="font-black text-sm text-pokeDark flex items-center gap-1 truncate max-w-[140px]">
                    ${isSelf ? '<i class="fa-solid fa-user-astronaut text-pokeRed"></i>' : '<i class="fa-solid fa-user text-amber-600"></i>'}
                    ${escapeHtml(pName)}
                  </span>
                  <span class="text-[10px] bg-amber-200 text-amber-900 border border-pokeDark px-2 py-0.5 rounded-md font-bold">
                    ${isSelf ? '你的卡牌' : '玩家卡牌'}
                  </span>
                </div>

                <!-- Answer Content Box -->
                <div class="my-auto text-center py-2 px-1">
                  <p class="text-xs text-amber-700 font-bold mb-1">感應結果</p>
                  <h4 class="text-xl sm:text-2xl font-black text-pokeDark break-words leading-tight">
                    ${escapeHtml(answer)}
                  </h4>
                </div>

                <!-- Footer Tag -->
                <div class="border-t-2 border-amber-300 pt-2 flex justify-between items-center text-[10px] font-bold text-amber-800">
                  <span><i class="fa-solid fa-bolt text-yellow-500"></i> TELEPATHY</span>
                  <span class="text-emerald-700"><i class="fa-solid fa-check"></i> 揭曉完畢</span>
                </div>
              </div>

            </div>
          </div>
        `;
      });

      grid.innerHTML = html;
    }

    // Render Tacit Understanding / Match Stats
    function renderMatchStats() {
      const statsSection = document.getElementById("matchStatsSection");
      const statsText = document.getElementById("matchStatsText");

      if (currentStatus !== "revealed") {
        statsSection.classList.add("hidden");
        return;
      }

      const answersList = Object.values(currentAnswers).map(a => a.trim().toLowerCase());
      if (answersList.length < 2) {
        statsSection.classList.remove("hidden");
        statsText.innerText = "人數不足兩人，請邀請更多朋友對頻！";
        return;
      }

      // Count Frequency of Answers
      const counts = {};
      let maxCount = 0;
      let mostCommonAns = "";

      answersList.forEach(ans => {
        counts[ans] = (counts[ans] || 0) + 1;
        if (counts[ans] > maxCount) {
          maxCount = counts[ans];
          mostCommonAns = ans;
        }
      });

      const total = answersList.length;
      const matchPercentage = Math.round((maxCount / total) * 100);

      statsSection.classList.remove("hidden");

      if (matchPercentage === 100) {
        statsText.innerHTML = `🎉 100% 完美默契！全員同步選了「<span class="text-pokeRed font-black underline">${escapeHtml(mostCommonAns)}</span>」！`;
      } else if (matchPercentage >= 50) {
        statsText.innerHTML = `✨ 默契高達 ${matchPercentage}%！共有 ${maxCount} 人心有靈犀！`;
      } else {
        statsText.innerHTML = `🌀 默契指數 ${matchPercentage}% ~ 大家的想法千奇百怪！`;
      }
    }

    // Helper: Escape HTML to avoid XSS
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>
