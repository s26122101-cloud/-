<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>雲端心電感應 - 默契大考驗</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Fredoka & Noto Sans TC -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Noto+Sans+TC:wght@500;700;900&display=swap" rel="stylesheet">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            pokeBg: '#FFFDF0',
            pokeCard: '#FEF9C3',
            pokeYellow: '#FACC15',
            pokeDarkYellow: '#CA8A04',
            pokeRed: '#EF4444',
            pokeBlue: '#3B82F6',
            pokeDark: '#451A03'
          },
          fontFamily: {
            sans: ['Fredoka', 'Noto Sans TC', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* 3D Flip Card Styles */
    .card-scene {
      perspective: 1000px;
    }
    .card-object {
      width: 100%;
      height: 220px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .card-object.is-flipped {
      transform: rotateY(180deg);
    }
    .card-face {
      position: absolute;
      width: 100%;
      height: 100%;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      border-radius: 1.25rem;
      box-shadow: 0 10px 25px -5px rgba(69, 26, 3, 0.15), 0 8px 10px -6px rgba(69, 26, 3, 0.1);
    }
    /* Card Back (Unrevealed Pokéball Style) */
    .card-face-back {
      background: linear-gradient(135deg, #F87171 0%, #EF4444 50%, #DC2626 50%, #FFFFFF 50%, #F3F4F6 100%);
      border: 5px solid #CA8A04;
    }
    /* Card Front (Revealed Answer Side) */
    .card-face-front {
      transform: rotateY(180deg);
      background: #FFFBEB;
      border: 5px solid #F59E0B;
    }
    
    /* Pokéball Center Circle Ornament */
    .pokeball-btn-center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 44px;
      height: 44px;
      background-color: white;
      border: 6px solid #451A03;
      border-radius: 50%;
      box-shadow: inset -2px -2px 0px rgba(0,0,0,0.2);
    }
    .pokeball-btn-center::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 16px;
      height: 16px;
      background-color: #FEF08A;
      border: 2px solid #451A03;
      border-radius: 50%;
    }

    /* Pulse & Bounce animations */
    @keyframes pokeballPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    .animate-poke-bounce {
      animation: pokeballPulse 2s infinite ease-in-out;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #FEF08A;
    }
    ::-webkit-scrollbar-thumb {
      background: #F59E0B;
      border-radius: 4px;
    }
  </style>
</head>

<body class="bg-pokeBg text-pokeDark min-h-screen font-sans flex flex-col justify-between selection:bg-pokeYellow selection:text-pokeDark">

